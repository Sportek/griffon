# Optional: route Playwright's browser traffic through an explicit proxy server
# you control or subscribe to (NOT ProtonVPN -- they deliberately don't offer a
# SOCKS5/HTTP proxy, only a full VPN tunnel: https://protonvpn.com/support/socks5).
# Leave unset -- the normal setup: just connect the ProtonVPN app (system-wide),
# and every process on the machine, including this scraper, is tunneled
# automatically. No code or env changes needed.
# PROXY_SERVER=socks5://127.0.0.1:9050
# PROXY_USERNAME=
# PROXY_PASSWORD=

# --- Proximity enrichment (--enrich) -------------------------------------------
# Contact sent in the User-Agent to OpenStreetMap services (Nominatim/Overpass ask for one).
# GEOCODER_EMAIL=you@example.com
# Self-hosted alternatives for heavy use (the public instances are rate limited):
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# --- Facebook groups source (python -m scraper.main facebook) -------------------
# Groups the scraping account is a member of: comma-separated URLs, ids or slugs.
FACEBOOK_GROUPS=https://www.facebook.com/groups/242242325809377,https://www.facebook.com/groups/232947036803405,https://www.facebook.com/groups/logementpmr.annonces
# Session file made by `python -m scraper.facebook_login` (default /data/facebook/storage_state.json).
# FACEBOOK_STORAGE_STATE=facebook_state.json
# Seen posts + LLM cache (default: cache.json next to the session file).
# FACEBOOK_CACHE=data/facebook_cache.json
# FACEBOOK_MAX_POSTS_PER_GROUP=60
# FACEBOOK_MAX_SCROLLS=25
# FACEBOOK_STOP_AFTER_SEEN=3
# FACEBOOK_MAX_AGE_DAYS=14
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# FACEBOOK_LLM_BATCH_SIZE=25
# FACEBOOK_LLM_MAX_CHARS=600
# FACEBOOK_LLM_TOKEN_BUDGET=150000
