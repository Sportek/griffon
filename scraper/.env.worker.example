# listings-api GraphQL endpoint and its API_KEY.
# Same machine as the API stack: http://host.docker.internal:8080/graphql (or the LAN IP);
# API on Wyvern: https://<your-domain>/graphql
LISTINGS_API_URL=http://192.168.1.10:8080/graphql
LISTINGS_API_KEY=change-me

WORKER_NAME=gremlin
# Leave empty to accept every source, or split them across workers, e.g.:
# WORKER_SOURCES=duproprio,kijiji,centris,logis_quebec
WORKER_SOURCES=
WORKER_POLL_SECONDS=60

# Politeness (seconds between two requests to the same site; per-run request cap).
SCRAPER_MIN_DELAY=2.0
SCRAPER_MAX_DELAY=5.0
SCRAPER_MAX_REQUESTS=6000
SCRAPER_BLOCK_THRESHOLD=3
SCRAPER_BROWSER_MIN_DELAY=3.0
SCRAPER_BROWSER_MAX_DELAY=7.0

# OpenStreetMap services (Nominatim/Overpass) ask for a contact in the User-Agent.
GEOCODER_EMAIL=

# --- Facebook groups source (README, "Source Facebook") --------------------------
# Groups the scraping account is a member of: comma-separated URLs, ids or slugs.
FACEBOOK_GROUPS=https://www.facebook.com/groups/242242325809377,https://www.facebook.com/groups/232947036803405,https://www.facebook.com/groups/logementpmr.annonces
# Optional: the session file from `python -m scraper.facebook_login --b64`, base64-encoded.
# Seeds /data/facebook/storage_state.json (rewritten only when this value changes).
FACEBOOK_STORAGE_STATE_B64=
# Caps per group and per run (keep them small: a few runs a day).
FACEBOOK_MAX_POSTS_PER_GROUP=60
FACEBOOK_MAX_SCROLLS=25
FACEBOOK_MAX_AGE_DAYS=14
# LLM classification (OpenRouter). Without a key, keyword rules only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Hard cap of prompt + completion tokens per run.
FACEBOOK_LLM_TOKEN_BUDGET=150000
