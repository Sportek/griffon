# listings-api GraphQL endpoint and its API_KEY.
# Same machine as the API stack: http://host.docker.internal:8080/graphql (or the LAN IP);
# API on Wyvern: https://<your-domain>/graphql
LISTINGS_API_URL=http://192.168.1.10:8080/graphql
LISTINGS_API_KEY=change-me

WORKER_NAME=gremlin
# Leave empty to accept every source, or split them across workers, e.g.:
# WORKER_SOURCES=duproprio,kijiji,centris,logis_quebec
WORKER_SOURCES=
WORKER_POLL_SECONDS=60

# Politeness (seconds between two requests to the same site; per-run request cap).
SCRAPER_MIN_DELAY=2.0
SCRAPER_MAX_DELAY=5.0
SCRAPER_MAX_REQUESTS=6000
SCRAPER_BLOCK_THRESHOLD=3
SCRAPER_BROWSER_MIN_DELAY=3.0
SCRAPER_BROWSER_MAX_DELAY=7.0

# OpenStreetMap services (Nominatim/Overpass) ask for a contact in the User-Agent.
GEOCODER_EMAIL=
