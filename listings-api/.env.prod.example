# Copy to .env.prod (never commit it). Generate secrets with: openssl rand -hex 32
MONGO_USER=listings
MONGO_PASSWORD=change-me
API_KEY=change-me

# Where the API listens on the host. Keep 127.0.0.1 behind a reverse proxy; use the LAN IP
# (or 0.0.0.0) only if a worker on another machine of your network must reach it directly.
API_BIND=127.0.0.1
API_PORT=8080

# Reads need the key too (set false only for a trusted LAN).
API_KEY_PROTECT_QUERIES=true
GRAPHIQL_ENABLED=false
# Origins of a future web front, comma-separated (empty = no browser access).
CORS_ALLOWED_ORIGINS=

INACTIVITY_STALE_AFTER=3d
# Notified when a scrape fails. Format: JSON, SLACK or DISCORD.
OPS_WEBHOOK_URL=
OPS_WEBHOOK_FORMAT=DISCORD

BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# --profile worker (everything on one host)
WORKER_NAME=gremlin
WORKER_SOURCES=
GEOCODER_EMAIL=
